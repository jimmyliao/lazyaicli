#!/usr/bin/env bash
# ags — Antigravity CLI (agy) Session browser & resume
# List your local agy conversations (directory / time / preview); pick one to resume.
#
#   ags              # interactive pick (fzf, else number menu) -> cd cwd && agy --conversation
#   ags -l           # list only (newest at the bottom, number 1 = newest)
#   ags <id|keyword> # resume by id prefix, or preview keyword
#   ags <N>          # resume by list number (1 = newest)
#
# Conversations are persisted by agy at ~/.gemini/antigravity-cli/conversations/<UUID>.db (sqlite) or .pb (protobuf).
# Language: auto (zh if your locale is zh*, else en). Override with LAZYAICLI_LANG=en|zh.
set -euo pipefail

AGY_HOME="${AGY_HOME:-$HOME/.gemini/antigravity-cli}"
SCRIPT="${BASH_SOURCE[0]}"
if [ -L "$SCRIPT" ]; then
  TARGET="$(readlink "$SCRIPT")"
  case "$TARGET" in /*) SCRIPT="$TARGET" ;; *) SCRIPT="$(dirname "$SCRIPT")/$TARGET" ;; esac
fi
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

# --- i18n: pick language once, then t <en> <zh> ----------------------------
case "${LAZYAICLI_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
  zh*) _LANG=zh ;;
  *)   _LANG=en ;;
esac
t() { if [ "$_LANG" = zh ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v uv >/dev/null 2>&1; then
    uv run --no-project python "$@"
  else
    echo "$(t "✗ session parsing needs python3 or uv." "✗ 解析 session 需要 python3 或 uv。")" >&2
    return 127
  fi
}

usage() {
  cat <<EOF
Usage: ags [list|-l|CONVERSATION_NUMBER|ID_PREFIX|KEYWORD]

Browse Antigravity conversations and resume one with: agy --conversation <id>
  ags              interactive picker
  ags -l           list conversations (1 = newest)
  ags 1            resume newest conversation
  ags keyword      resume newest literal match
EOF
}

version() {
  local rev="dev"
  command -v git >/dev/null 2>&1 && rev="$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || printf dev)"
  printf 'lazyaicli %s (ags)\n' "$rev"
}

gather() {
  run_python - "$AGY_HOME" <<'PY'
import os, sys, json, glob, time, re, sqlite3
home = sys.argv[1]
conv = os.path.join(home, "conversations")
now = time.time()

def ago(mt):
    s = now - mt
    if s < 90: return f"{int(s)}s ago"
    if s < 5400: return f"{int(s/60)}m ago"
    if s < 172800: return f"{int(s/3600)}h ago"
    return f"{int(s/86400)}d ago"

# cwd map: invert cache/last_conversations.json (cwd -> id)  =>  id -> cwd
id2cwd = {}
try:
    with open(os.path.join(home, "cache", "last_conversations.json")) as fh:
        for cwd, cid in json.load(fh).items():
            id2cwd[cid] = cwd
except Exception:
    pass

# Pull the first "prose-like" readable run from a blob as a preview. The payload
# is schema-less protobuf, so this is heuristic.
TEXT = re.compile(r'[\x20-\x7e一-鿿]{6,}')
def looks_like_prose(run):
    run = run.strip()
    if len(run) < 8 or " " not in run or run[0] in "{[/<":
        return False
    # Natural language: high ratio of letters / digits / CJK / spaces — filters protobuf binary noise.
    ok = sum(c.isalnum() or c.isspace() or "一" <= c <= "鿿" for c in run)
    return ok / len(run) >= 0.75
def preview_from(blobs):
    for b in blobs:
        if not b:
            continue
        try:
            t = b.decode("utf-8", "ignore") if isinstance(b, (bytes, bytearray)) else str(b)
        except Exception:
            continue
        for run in TEXT.findall(t):
            if looks_like_prose(run):
                return run.strip()
    return ""

def preview_db(path):
    try:
        con = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        blobs = [r[0] for r in con.execute(
            "SELECT step_payload FROM steps ORDER BY idx LIMIT 16")]
        con.close()
        return preview_from(blobs)
    except Exception:
        return ""

for f in glob.glob(os.path.join(conv, "*.db")) + glob.glob(os.path.join(conv, "*.pb")):
    cid = os.path.splitext(os.path.basename(f))[0]
    try:
        mt = os.path.getmtime(f)
    except OSError:
        continue
    cwd = id2cwd.get(cid, "")
    # agy stores no title -> use the first prompt as the name (in brackets, like ccs's [title]).
    # Readable from .db (sqlite); .pb (legacy) is opaque so it shows [legacy].
    prev = " ".join((preview_db(f) if f.endswith(".db") else "").split())
    if prev:
        name = prev[:70]
    elif f.endswith(".pb"):
        name = "legacy"
    else:
        name = "untitled"
    short_cwd = (cwd or "(unknown cwd)").replace(os.path.expanduser("~"), "~")
    disp = f"{ago(mt):>8}  [{name}]  {short_cwd}"
    # TSV: id \t cwd \t mtime \t name \t preview \t displayline
    print("\t".join([cid, cwd, f"{mt:.0f}", name, prev[:90], disp]))
PY
}

resume() {
  local id="$1" cwd="$2"
  # DRYRUN: just print the command (no agy needed) — preview only.
  if [ "${AGS_DRYRUN:-}" = "1" ]; then
    echo "→ cd ${cwd:-\$HOME} && agy --conversation $id"
    return 0
  fi
  # Resuming needs agy on PATH (listing does not).
  if ! command -v agy >/dev/null 2>&1; then
    echo "$(t "✗ 'agy' not found — Antigravity CLI isn't installed or not on PATH. Install it to resume." \
             "✗ 找不到 'agy' 指令——未安裝 Antigravity CLI 或不在 PATH。安裝後即可還原。")" >&2
    echo "  https://antigravity.google/download" >&2
    exit 1
  fi
  # AGS_EMIT=1: just print cwd<TAB>id for the sourced ags() function to cd + resume in the current shell.
  if [ "${AGS_EMIT:-}" = "1" ]; then
    printf '%s\t%s\n' "$cwd" "$id"
    return 0
  fi
  echo "→ cd ${cwd:-\$HOME} && agy --conversation $id"
  if [ -n "$cwd" ] && cd "$cwd" 2>/dev/null; then
    :
  else
    [ -n "$cwd" ] && echo "$(t "⚠ directory not found: ${cwd} — resuming from \$HOME instead" \
                              "⚠ 目錄不存在：${cwd}，改在 \$HOME 還原")" >&2
    cd "$HOME"
  fi
  exec agy --conversation "$id"
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --version) version; exit 0 ;;
  esac
  local tsv
  tsv="$(gather | sort -t$'\t' -k3,3nr)"   # newest first
  if [ -z "$tsv" ]; then
    if [ ! -d "$AGY_HOME/conversations" ]; then
      echo "$(t "No agy conversations dir (${AGY_HOME}/conversations) — is Antigravity CLI installed and used at least once?" \
               "找不到 agy 對話目錄（${AGY_HOME}/conversations）——裝了 Antigravity CLI 並用過至少一次嗎？")" >&2
    else
      echo "$(t "No agy conversations yet (${AGY_HOME}/conversations)." \
               "目前沒有任何 agy 對話（${AGY_HOME}/conversations）。")" >&2
    fi
    exit 1
  fi

  # List only (newest at the bottom, next to the prompt; number 1 = newest).
  if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ] || [ "${1:-}" = "ls" ] || [ "${1:-}" = "list" ]; then
    printf '%s\n' "$tsv" | awk -F'\t' '{n[NR]=$6} END{for(i=NR;i>=1;i--) printf "%2d) %s\n", i, n[i]}'
    exit 0
  fi

  # Direct argument: a pure number = list index (1 = newest); otherwise id prefix / keyword.
  if [ -n "${1:-}" ]; then
    local match
    if printf '%s' "$1" | grep -qE '^[0-9]+$'; then
      match="$(printf '%s\n' "$tsv" | sed -n "${1}p")"
      if [ -z "$match" ]; then
        local total; total="$(printf '%s\n' "$tsv" | grep -c .)"
        echo "$(t "No conversation #${1} (${total} total)" "沒有第 ${1} 個對話（共 ${total} 個）")" >&2
        exit 1
      fi
    else
      match="$(printf '%s\n' "$tsv" | grep -iF -m1 -- "$1" || true)"
      if [ -z "$match" ]; then
        echo "$(t "No conversation matching \"${1}\"" "沒有符合「${1}」的對話")" >&2
        exit 1
      fi
    fi
    resume "$(printf '%s' "$match" | cut -f1)" "$(printf '%s' "$match" | cut -f2)"
    exit 0
  fi

  # Interactive pick.
  if command -v fzf >/dev/null 2>&1; then
    local pick
    pick="$(printf '%s\n' "$tsv" \
      | fzf --delimiter='\t' --with-nth=6 --height=90% --reverse \
            --prompt='resume> ' --header="$(t "↑↓ choose · Enter resume · Esc cancel" "↑↓ 選 agy 對話 · Enter 還原 · Esc 取消")")" || exit 0
    [ -z "$pick" ] && exit 0
    resume "$(printf '%s' "$pick" | cut -f1)" "$(printf '%s' "$pick" | cut -f2)"
  else
    printf '%s\n' "$tsv" | awk -F'\t' '{printf "%2d) %s\n", NR, $6}'
    printf '%s' "$(t "Pick # (Enter to cancel): " "選擇 #（Enter 取消）：")"
    read -r n
    [ -z "$n" ] && exit 0
    local line
    line="$(printf '%s\n' "$tsv" | sed -n "${n}p")"
    [ -z "$line" ] && { echo "$(t "invalid choice" "無效選擇")" >&2; exit 1; }
    resume "$(printf '%s' "$line" | cut -f1)" "$(printf '%s' "$line" | cut -f2)"
  fi
}

main "$@"
