#!/usr/bin/env bash
# ccs — Claude Code Session browser & resume
# List your local Claude Code sessions (title / last prompt / directory); pick one to resume.
#
#   ccs              # interactive pick (fzf, else number menu) -> cd cwd && claude --resume
#   ccs -l           # list only, no resume
#   ccs <id|keyword> # resume by id prefix, or title/last-prompt keyword
#   ccs <N>          # resume by list number (1 = newest)
#
# Sessions are written continuously by Claude Code itself — no manual save needed.
# Language: auto (zh if your locale is zh*, else en). Override with LAZYAICLI_LANG=en|zh.
set -euo pipefail

PROJECTS="${CLAUDE_PROJECTS:-$HOME/.claude/projects}"

# --- i18n: pick language once, then t <en> <zh> ----------------------------
case "${LAZYAICLI_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
  zh*) _LANG=zh ;;
  *)   _LANG=en ;;
esac
t() { if [ "$_LANG" = zh ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

gather() {
  python3 - "$PROJECTS" <<'PY'
import os, sys, json, glob, time
root = sys.argv[1]
now = time.time()

def ago(mt):
    s = now - mt
    if s < 90: return f"{int(s)}s ago"
    if s < 5400: return f"{int(s/60)}m ago"
    if s < 172800: return f"{int(s/3600)}h ago"
    return f"{int(s/86400)}d ago"

rows = []
for f in glob.glob(os.path.join(root, "*", "*.jsonl")):
    sid = os.path.basename(f)[:-6]
    try:
        mt = os.path.getmtime(f)
        size = os.path.getsize(f)
    except OSError:
        continue
    ctitle = aititle = lastp = cwd = None
    try:
        with open(f, "rb") as fh:
            if size > 262144:          # big file: head 16KB (launch cwd) + tail 256KB (title/last prompt)
                head = fh.read(16384).decode("utf-8", "ignore")
                fh.seek(-262144, 2)
                fh.readline()
                tail = fh.read().decode("utf-8", "ignore")
            else:
                head = tail = fh.read().decode("utf-8", "ignore")
    except OSError:
        continue
    # Launch dir = the FIRST cwd. `claude --resume` resolves a session by
    # current-dir -> project-dir, not the last cwd a session cd'ed into;
    # using the wrong one yields "No conversation found".
    for line in head.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        if d.get("cwd"):
            cwd = d.get("cwd")
            break
    # Title / last prompt live near the end.
    for line in tail.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        t = d.get("type")
        if t == "custom-title":
            ctitle = d.get("customTitle") or ctitle
        elif t == "ai-title":
            aititle = d.get("aiTitle") or aititle
        elif t == "last-prompt":
            lastp = d.get("lastPrompt") or lastp
        if cwd is None and d.get("cwd"):   # fallback if head had no cwd (small files)
            cwd = d.get("cwd")
    if not cwd:                        # last resort: decode the project dir name
        dn = os.path.basename(os.path.dirname(f))
        cwd = "/" + dn.strip("-").replace("-", "/")
    title = ctitle or aititle or "(untitled)"
    lastp = " ".join((lastp or "").split())
    short_cwd = cwd.replace(os.path.expanduser("~"), "~")
    disp = f"{ago(mt):>8}  [{title}]  {short_cwd}"
    if lastp:
        disp += f"  ↳ {lastp[:90]}"
    # TSV: sid \t cwd \t mtime \t title \t lastprompt \t displayline
    print("\t".join([sid, cwd, f"{mt:.0f}", title, lastp, disp]))
rows  # keep linters quiet
PY
}

resume() {
  local id="$1" cwd="$2"
  # DRYRUN: just print the command (no claude needed) — preview only.
  if [ "${CCS_DRYRUN:-}" = "1" ]; then
    echo "→ cd ${cwd:-\$HOME} && claude --resume $id"
    return 0
  fi
  # Resuming needs claude on PATH (listing does not).
  if ! command -v claude >/dev/null 2>&1; then
    echo "$(t "✗ 'claude' not found — Claude Code isn't installed or not on PATH. Install it to resume." \
             "✗ 找不到 'claude' 指令——未安裝 Claude Code 或不在 PATH。安裝後即可還原。")" >&2
    echo "  https://docs.claude.com/claude-code" >&2
    exit 1
  fi
  # CCS_EMIT=1: just print cwd<TAB>id for the sourced ccs() function to cd + resume in the current shell.
  if [ "${CCS_EMIT:-}" = "1" ]; then
    printf '%s\t%s\n' "$cwd" "$id"
    return 0
  fi
  echo "→ cd $cwd && claude --resume $id"
  if ! cd "$cwd" 2>/dev/null; then
    echo "$(t "⚠ directory not found: ${cwd} — resuming from \$HOME instead" \
             "⚠ 目錄不存在：${cwd}，改在 \$HOME 還原")" >&2
    cd "$HOME"
  fi
  exec claude --resume "$id"
}

main() {
  local tsv
  tsv="$(gather | sort -t$'\t' -k3,3nr)"   # newest first
  if [ -z "$tsv" ]; then
    if [ ! -d "$PROJECTS" ]; then
      echo "$(t "No Claude Code sessions dir (${PROJECTS}) — is Claude Code installed and used at least once?" \
               "找不到 Claude Code session 目錄（${PROJECTS}）——裝了 Claude Code 並用過至少一次嗎？")" >&2
    else
      echo "$(t "No Claude Code sessions yet (${PROJECTS})." \
               "目前沒有任何 Claude Code session（${PROJECTS}）。")" >&2
    fi
    exit 1
  fi

  # List only (newest at the bottom, next to the prompt; number 1 = newest).
  if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ] || [ "${1:-}" = "ls" ] || [ "${1:-}" = "list" ]; then
    printf '%s\n' "$tsv" | awk -F'\t' '{n[NR]=$6} END{for(i=NR;i>=1;i--) printf "%2d) %s\n", i, n[i]}'
    exit 0
  fi

  # Direct argument: a pure number = list index (1 = newest, matches `ccs -l`); otherwise id prefix / keyword.
  if [ -n "${1:-}" ]; then
    local match
    if printf '%s' "$1" | grep -qE '^[0-9]+$'; then
      match="$(printf '%s\n' "$tsv" | sed -n "${1}p")"
      if [ -z "$match" ]; then
        local total; total="$(printf '%s\n' "$tsv" | grep -c .)"
        echo "$(t "No session #${1} (${total} total)" "沒有第 ${1} 個 session（共 ${total} 個）")" >&2
        exit 1
      fi
    else
      match="$(printf '%s\n' "$tsv" | grep -i -m1 -- "$1" || true)"
      if [ -z "$match" ]; then
        echo "$(t "No session matching \"${1}\"" "沒有符合「${1}」的 session")" >&2
        exit 1
      fi
    fi
    resume "$(printf '%s' "$match" | cut -f1)" "$(printf '%s' "$match" | cut -f2)"
    exit 0
  fi

  # Interactive pick.
  if command -v fzf >/dev/null 2>&1; then
    local pick
    pick="$(printf '%s\n' "$tsv" \
      | fzf --delimiter='\t' --with-nth=6 --height=90% --reverse \
            --prompt='resume> ' --header="$(t "↑↓ choose · Enter resume · Esc cancel" "↑↓ 選 session · Enter 還原 · Esc 取消")")" || exit 0
    [ -z "$pick" ] && exit 0
    resume "$(printf '%s' "$pick" | cut -f1)" "$(printf '%s' "$pick" | cut -f2)"
  else
    printf '%s\n' "$tsv" | awk -F'\t' '{printf "%2d) %s\n", NR, $6}'
    printf '%s' "$(t "Pick # (Enter to cancel): " "選擇 #（Enter 取消）：")"
    read -r n
    [ -z "$n" ] && exit 0
    local line
    line="$(printf '%s\n' "$tsv" | sed -n "${n}p")"
    [ -z "$line" ] && { echo "$(t "invalid choice" "無效選擇")" >&2; exit 1; }
    resume "$(printf '%s' "$line" | cut -f1)" "$(printf '%s' "$line" | cut -f2)"
  fi
}

main "$@"
