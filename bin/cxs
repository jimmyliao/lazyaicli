#!/usr/bin/env bash
# cxs — Codex CLI Session browser & resume
# List your local codex sessions (name / directory / time); pick one to resume.
#
#   cxs              # interactive pick (fzf, else number menu) -> cd cwd && codex resume <id>
#   cxs -l           # list only (newest at the bottom, number 1 = newest)
#   cxs <id|keyword> # resume by id prefix, or name keyword
#   cxs <N>          # resume by list number (1 = newest)
#
# Sessions are written by codex at ~/.codex/sessions/YYYY/MM/DD/rollout-*-<UUID>.jsonl (plain JSONL).
# Language: auto (zh if your locale is zh*, else en). Override with LAZYAICLI_LANG=en|zh.
set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
SCRIPT="${BASH_SOURCE[0]}"
if [ -L "$SCRIPT" ]; then
  TARGET="$(readlink "$SCRIPT")"
  case "$TARGET" in /*) SCRIPT="$TARGET" ;; *) SCRIPT="$(dirname "$SCRIPT")/$TARGET" ;; esac
fi
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

# --- i18n: pick language once, then t <en> <zh> ----------------------------
case "${LAZYAICLI_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
  zh*) _LANG=zh ;;
  *)   _LANG=en ;;
esac
t() { if [ "$_LANG" = zh ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }

run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v uv >/dev/null 2>&1; then
    uv run --no-project python "$@"
  else
    echo "$(t "✗ session parsing needs python3 or uv." "✗ 解析 session 需要 python3 或 uv。")" >&2
    return 127
  fi
}

usage() {
  cat <<EOF
Usage: cxs [list|-l|SESSION_NUMBER|ID_PREFIX|KEYWORD]

Browse Codex sessions and resume one with: codex resume <id>
  cxs              interactive picker
  cxs -l           list sessions (1 = newest)
  cxs 1            resume newest session
  cxs keyword      resume newest literal match
EOF
}

version() {
  local rev="dev"
  command -v git >/dev/null 2>&1 && rev="$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || printf dev)"
  printf 'lazyaicli %s (cxs)\n' "$rev"
}

gather() {
  run_python - "$CODEX_HOME" <<'PY'
import os, sys, json, glob, time
home = sys.argv[1]
sess = os.path.join(home, "sessions")
now = time.time()

def ago(mt):
    s = now - mt
    if s < 90: return f"{int(s)}s ago"
    if s < 5400: return f"{int(s/60)}m ago"
    if s < 172800: return f"{int(s/3600)}h ago"
    return f"{int(s/86400)}d ago"

# codex injects AGENTS.md / environment / instructions as "user" messages at the
# start; skip those to reach the real first user prompt.
def is_injected(txt):
    t = txt.lstrip()
    if not t or t[0] in "<#":
        return True
    low = t[:300].lower()
    if low.startswith("workspace:") or low.startswith("cwd:"):
        return True
    for k in ("instructions for", "<instructions>", "environment_context",
              "user_instructions", "agents.md", "<user", "<env", "# agents"):
        if k in low:
            return True
    return False

for f in glob.glob(os.path.join(sess, "**", "*.jsonl"), recursive=True):
    try:
        mt = os.path.getmtime(f)
    except OSError:
        continue
    sid = cwd = name = None
    try:
        with open(f, "r", encoding="utf-8", errors="ignore") as fh:
            chunk = fh.read(262144)  # head 256KB: still reaches the first real prompt past AGENTS.md/env injections
    except OSError:
        continue
    for line in chunk.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue
        t = d.get("type")
        p = d.get("payload", {}) if isinstance(d.get("payload"), dict) else {}
        if t == "session_meta":
            sid = p.get("id") or sid
            cwd = p.get("cwd") or cwd
        elif t == "response_item" and p.get("type") == "message" and p.get("role") == "user":
            for c in p.get("content", []) or []:
                if isinstance(c, dict) and c.get("type") == "input_text":
                    txt = (c.get("text") or "").strip()
                    if name is None and txt and not is_injected(txt):
                        name = " ".join(txt.split())
        if sid and name:
            break
    if not sid:  # fallback: trailing UUID in the filename
        base = os.path.basename(f)
        sid = base.rsplit("-", 5)[-5:] and "-".join(base[:-6].split("-")[-5:]) or base[:-6]
    name = (name or "(untitled)")[:70]
    short_cwd = (cwd or "(unknown cwd)").replace(os.path.expanduser("~"), "~")
    disp = f"{ago(mt):>8}  [{name}]  {short_cwd}"
    # TSV: id \t cwd \t mtime \t name \t (preview empty) \t displayline
    print("\t".join([sid, cwd or "", f"{mt:.0f}", name, "", disp]))
PY
}

resume() {
  local id="$1" cwd="$2"
  # DRYRUN: just print the command (no codex needed) — preview only.
  if [ "${CXS_DRYRUN:-}" = "1" ]; then
    echo "→ cd ${cwd:-\$HOME} && codex resume $id"
    return 0
  fi
  # Resuming needs codex on PATH (listing does not).
  if ! command -v codex >/dev/null 2>&1; then
    echo "$(t "✗ 'codex' not found — Codex CLI isn't installed or not on PATH. Install it to resume." \
             "✗ 找不到 'codex' 指令——未安裝 Codex CLI 或不在 PATH。安裝後即可還原。")" >&2
    echo "  https://github.com/openai/codex" >&2
    exit 1
  fi
  # CXS_EMIT=1: just print cwd<TAB>id for the sourced cxs() function to cd + resume in the current shell.
  if [ "${CXS_EMIT:-}" = "1" ]; then
    printf '%s\t%s\n' "$cwd" "$id"
    return 0
  fi
  echo "→ cd ${cwd:-\$HOME} && codex resume $id"
  if [ -n "$cwd" ] && cd "$cwd" 2>/dev/null; then
    :
  else
    [ -n "$cwd" ] && echo "$(t "⚠ directory not found: ${cwd} — resuming from \$HOME instead" \
                              "⚠ 目錄不存在：${cwd}，改在 \$HOME 還原")" >&2
    cd "$HOME"
  fi
  exec codex resume "$id"
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --version) version; exit 0 ;;
  esac
  local tsv
  tsv="$(gather | sort -t$'\t' -k3,3nr)"   # newest first
  if [ -z "$tsv" ]; then
    if [ ! -d "$CODEX_HOME/sessions" ]; then
      echo "$(t "No codex sessions dir (${CODEX_HOME}/sessions) — is Codex CLI installed and used at least once?" \
               "找不到 codex session 目錄（${CODEX_HOME}/sessions）——裝了 Codex CLI 並用過至少一次嗎？")" >&2
    else
      echo "$(t "No codex sessions yet (${CODEX_HOME}/sessions)." \
               "目前沒有任何 codex session（${CODEX_HOME}/sessions）。")" >&2
    fi
    exit 1
  fi

  # List only (newest at the bottom, next to the prompt; number 1 = newest).
  if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ] || [ "${1:-}" = "ls" ] || [ "${1:-}" = "list" ]; then
    printf '%s\n' "$tsv" | awk -F'\t' '{n[NR]=$6} END{for(i=NR;i>=1;i--) printf "%2d) %s\n", i, n[i]}'
    exit 0
  fi

  # Direct argument: a pure number = list index (1 = newest); otherwise id prefix / keyword.
  if [ -n "${1:-}" ]; then
    local match
    if printf '%s' "$1" | grep -qE '^[0-9]+$'; then
      match="$(printf '%s\n' "$tsv" | sed -n "${1}p")"
      if [ -z "$match" ]; then
        local total; total="$(printf '%s\n' "$tsv" | grep -c .)"
        echo "$(t "No session #${1} (${total} total)" "沒有第 ${1} 個 session（共 ${total} 個）")" >&2
        exit 1
      fi
    else
      match="$(printf '%s\n' "$tsv" | grep -iF -m1 -- "$1" || true)"
      if [ -z "$match" ]; then
        echo "$(t "No session matching \"${1}\"" "沒有符合「${1}」的 session")" >&2
        exit 1
      fi
    fi
    resume "$(printf '%s' "$match" | cut -f1)" "$(printf '%s' "$match" | cut -f2)"
    exit 0
  fi

  # Interactive pick.
  if command -v fzf >/dev/null 2>&1; then
    local pick
    pick="$(printf '%s\n' "$tsv" \
      | fzf --delimiter='\t' --with-nth=6 --height=90% --reverse \
            --prompt='resume> ' --header="$(t "↑↓ choose · Enter resume · Esc cancel" "↑↓ 選 codex session · Enter 還原 · Esc 取消")")" || exit 0
    [ -z "$pick" ] && exit 0
    resume "$(printf '%s' "$pick" | cut -f1)" "$(printf '%s' "$pick" | cut -f2)"
  else
    printf '%s\n' "$tsv" | awk -F'\t' '{printf "%2d) %s\n", NR, $6}'
    printf '%s' "$(t "Pick # (Enter to cancel): " "選擇 #（Enter 取消）：")"
    read -r n
    [ -z "$n" ] && exit 0
    local line
    line="$(printf '%s\n' "$tsv" | sed -n "${n}p")"
    [ -z "$line" ] && { echo "$(t "invalid choice" "無效選擇")" >&2; exit 1; }
    resume "$(printf '%s' "$line" | cut -f1)" "$(printf '%s' "$line" | cut -f2)"
  fi
}

main "$@"
