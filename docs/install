#!/usr/bin/env bash
# Vanity installer:  curl -fsSL ccs.jimmyliao.net/install | bash
#
# This file IS the bootstrap — served by GitHub Pages at ccs.jimmyliao.net/install.
# It fetches and runs lazyaicli's install.sh, which (in curl|bash mode) clones the
# release binary and sets up lazyai / lazyaicli / ccs / ags / cxs.
set -euo pipefail
exec bash <(curl -fsSL "https://raw.githubusercontent.com/jimmyliao/lazyaicli/main/install.sh")
